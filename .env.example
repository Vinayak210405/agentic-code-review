# Runtime
APP_ENV=development                # use "production" to enforce webhook signatures and API keys
REVIEW_API_KEY=change-me           # required in production for /api/v1/reviews* endpoints (X-API-Key header)

# LLM (optional — without a key the pipeline runs fully deterministic static analysis)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_PROVIDER=                      # none | openai | simulated (auto: openai if OPENAI_API_KEY is set)
LLM_MAX_CONCURRENCY=4

# Performance
EXECUTION_MODE=parallel            # parallel | sequential
FILE_WORKERS=4
ENABLE_RESULT_CACHE=true
ENABLE_BANDIT=true

# RAG
EMBEDDING_PROVIDER=                # local | openai (auto: openai if OPENAI_API_KEY is set)
RAG_TOP_K=3
QDRANT_URL=                        # e.g. http://localhost:6333 (requires requirements-optional.txt)

# Human-in-the-loop gate
HITL_BLOCK_SEVERITIES=CRITICAL,HIGH

# Persistence
CHECKPOINT_BACKEND=sqlite          # sqlite | memory
CHECKPOINT_DB_PATH=checkpoints.sqlite

# Integrations
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
SLACK_WEBHOOK_URL=
LANGCHAIN_API_KEY=                 # optional LangSmith tracing
